---
import { IMAGES, photo, srcset } from '../data/images';
import { SITE } from '../data/site';
---

<section class="discover section" id="find" data-surface="light" aria-labelledby="discover-title">
  <span id="story" class="anchor" aria-hidden="true"></span>
  <div class="container discover__grid">
    <div class="discover__copy">
      <p class="eyebrow eyebrow--terra" data-reveal="fade">Our best-kept secret — almost.</p>
      <h2 id="discover-title" class="h2" data-reveal="lines">
        <span class="line"><span>Can’t find us?</span></span>
      </h2>
      <p class="discover__secret" data-reveal="fade">
        Rotterdam&apos;s most flavorful secret is hiding in plain sight. We&apos;re right inside Hotel Teleport.
      </p>
      <p class="lede" data-reveal="fade">
        Ground floor of the hotel. Same door as the lobby — then follow the flavors.
      </p>
      <div class="discover__where" data-reveal="fade">
        <dl>
          <div>
            <dt>Find the door</dt>
            <dd>Ground floor · Teleport Hotel lobby</dd>
          </div>
        </dl>
        <a class="discover__address" href={SITE.mapsUrl} target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 21s-6-5.2-6-11a6 6 0 1 1 12 0c0 5.8-6 11-6 11z" stroke="currentColor" stroke-width="1.6" />
            <circle cx="12" cy="10" r="2.1" stroke="currentColor" stroke-width="1.6" />
          </svg>
          <span>{SITE.street}, {SITE.city}, Netherlands</span>
        </a>
        <ul class="discover__access">
          <li>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="3" y="10" width="18" height="8" rx="2" stroke="currentColor" stroke-width="1.5" />
              <path d="M6 10V7h3v3M15 10V8h3v2M7 14h2M11 14h2M15 14h2" stroke="currentColor" stroke-width="1.5" />
            </svg>
            <span>750m from Rotterdam Central Station.</span>
          </li>
          <li>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="3" y="8" width="18" height="8" rx="2" stroke="currentColor" stroke-width="1.5" />
              <path d="M6 16v2M18 16v2M7 11h3M14 11h3" stroke="currentColor" stroke-width="1.5" />
            </svg>
            <span>30 seconds away from Schiekade tram stop.</span>
          </li>
          <li>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="3" y="4" width="8" height="10" rx="1.5" stroke="currentColor" stroke-width="1.5" />
              <path d="M5 14v2M9 14v2M6 7h2" stroke="currentColor" stroke-width="1.5" />
              <circle cx="17" cy="15" r="3.2" stroke="currentColor" stroke-width="1.5" />
              <path d="M17 13.2v1.6l1.1.8" stroke="currentColor" stroke-width="1.4" />
            </svg>
            <span>Ample street parking and bike parking outside.</span>
          </li>
        </ul>
      </div>
      <a class="link-arrow" href="/our-story" data-reveal="fade">Read our story <span class="arrow">→</span></a>
    </div>

    <figure class="discover__interior">
      <div class="media media--round" data-reveal="image">
        <img
          data-parallax="0.14"
          src={photo(IMAGES.interiorMoody, 1400)}
          srcset={srcset(IMAGES.interiorMoody, [700, 1100, 1600])}
          sizes="(min-width: 1024px) 45vw, 92vw"
          alt="Basket of fresh naan bread from the tawa"
          loading="lazy"
        />
      </div>
      <figcaption>Fresh from the tawa</figcaption>
    </figure>

    <figure class="discover__food" data-drift="50">
      <div class="media" data-reveal="image" data-delay="0.2">
        <img
          src={photo(IMAGES.samosa, 900)}
          srcset={srcset(IMAGES.samosa, [500, 900, 1200])}
          sizes="(min-width: 1024px) 24vw, 60vw"
          alt="Crisp samosas with green chilli and chutney"
          loading="lazy"
        />
      </div>
    </figure>
  </div>
</section>

<style>
  .discover {
    position: relative;
    background: var(--cream);
  }
  .anchor {
    position: absolute;
    top: 0;
  }
  .discover__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: auto auto;
    column-gap: clamp(1rem, 2vw, 2rem);
  }
  .discover__copy {
    grid-column: 1 / span 5;
    grid-row: 1 / span 2;
    display: grid;
    align-content: start;
    gap: 2rem;
    padding-top: clamp(1rem, 6vw, 6rem);
    color: var(--petrol);
  }
  .discover__secret {
    margin: 0;
    max-width: 34rem;
    font-family: var(--serif);
    font-size: clamp(1.15rem, 2.2vw, 1.45rem);
    line-height: 1.45;
    color: var(--petrol);
  }
  .discover__where {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    margin-top: 1rem;
  }
  .discover__where dl {
    display: grid;
    gap: 0.9rem;
    margin: 0;
    width: 100%;
    max-width: 26rem;
  }
  .discover__where dl div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--ink-faint);
    font-size: 0.9rem;
  }
  .discover__where dt {
    color: var(--ink-soft);
  }
  .discover__where dd {
    margin: 0;
    font-weight: 600;
    text-align: right;
  }
  .discover__address {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 650;
    color: var(--petrol);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  .discover__address:hover {
    color: var(--terra);
  }
  .discover__access {
    display: grid;
    gap: 0.75rem;
    margin: 0.4rem 0 0;
    padding: 0;
    list-style: none;
    max-width: 28rem;
  }
  .discover__access li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.95rem;
    line-height: 1.4;
    transition: transform 0.35s var(--ease-out);
  }
  .discover__access svg {
    flex: none;
    color: var(--terra);
  }
  .discover__access li:hover {
    transform: translateX(4px);
  }
  .discover__interior {
    grid-column: 8 / span 5;
    grid-row: 1;
    margin: 0;
  }
  .discover__interior .media {
    aspect-ratio: 4 / 5;
    border-radius: 999px 999px var(--radius-lg) var(--radius-lg);
  }
  .discover__interior figcaption {
    margin-top: 1rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-align: right;
    color: var(--ink-soft);
  }
  .discover__food {
    grid-column: 6 / span 3;
    grid-row: 1;
    align-self: end;
    margin: 0 0 -4rem;
    z-index: 2;
  }
  .discover__food .media {
    aspect-ratio: 3 / 4;
    box-shadow: 0 30px 60px rgba(4, 57, 59, 0.25);
  }
  @media (max-width: 1023px) {
    .discover__grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      row-gap: 3rem;
    }
    .discover__copy {
      grid-column: 1 / -1;
      grid-row: auto;
      padding-top: 0;
    }
    .discover__interior {
      grid-column: 2 / -1;
      grid-row: auto;
    }
    .discover__food {
      grid-column: 1 / span 3;
      grid-row: auto;
      margin: -12rem 0 0;
    }
  }
  @media (max-width: 767px) {
    .discover__food {
      grid-column: 1 / span 4;
      margin-top: -8rem;
    }
  }
</style>
