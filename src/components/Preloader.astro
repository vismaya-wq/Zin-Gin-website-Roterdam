<div class="preloader" data-preloader data-surface="dark" aria-hidden="true">
  <div class="preloader__mark">
    <img src="/zin-gin-badge.png" alt="" width="120" height="120" />
    <p>Zin &amp; Gin</p>
  </div>
</div>

<script>
  const node = document.querySelector<HTMLElement>('[data-preloader]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const seen = sessionStorage.getItem('zg-intro');
  if (!node || reduced || seen) {
    node?.remove();
  } else {
    sessionStorage.setItem('zg-intro', '1');
    window.setTimeout(() => node.classList.add('is-done'), 1500);
    window.setTimeout(() => node.remove(), 1900);
  }
</script>

<style>
  .preloader {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    background: var(--petrol-deep);
    color: var(--ivory);
    transition: opacity 0.4s var(--ease-out), visibility 0.4s;
  }
  .preloader.is-done {
    opacity: 0;
    visibility: hidden;
  }
  .preloader__mark {
    display: grid;
    justify-items: center;
    gap: 0.8rem;
    text-align: center;
    animation: preloader-in 1.1s var(--ease-out) both;
  }
  .preloader__mark img {
    width: 108px;
    height: 108px;
    border-radius: 50%;
  }
  .preloader__mark p {
    margin: 0;
    font-family: var(--serif);
    font-size: 2.4rem;
    line-height: 1;
  }
  .preloader__mark small {
    max-width: 16rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(243, 235, 221, 0.72);
  }
  @keyframes preloader-in {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
  }
</style>
