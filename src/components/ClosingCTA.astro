---
import { IMAGES, photo, srcset } from '../data/images';
import { SITE } from '../data/site';
import BrandDoodles from './BrandDoodles.astro';
---

<section class="closing on-dark" data-surface="dark" aria-labelledby="closing-title">
  <BrandDoodles />
  <div class="closing__media media" aria-hidden="true">
    <img
      data-parallax="0.25"
      src={photo(IMAGES.pavPlatter, 1800)}
      srcset={srcset(IMAGES.pavPlatter)}
      sizes="100vw"
      alt=""
      loading="lazy"
    />
  </div>
  <div class="closing__shade" aria-hidden="true"></div>

  <div class="container container--sym closing__inner">
    <h2 id="closing-title" class="display" data-reveal="lines">
      <span class="line"><span>Make it a gathering</span></span>
      <span class="line"><span><em>worth remembering.</em></span></span>
    </h2>
    <p class="closing__copy" data-reveal="fade">
      From intimate celebrations to group gatherings and catering, bring your people together over authentic Indian flavours, botanical drinks and good company at Zin &amp; Gin.
    </p>
    <div class="closing__cta" data-reveal="fade">
      <a class="btn btn--light" href={SITE.whatsappEvents} target="_blank" rel="noopener noreferrer">Enquire on WhatsApp <span class="arrow arrow--diag">↗</span></a>
    </div>
  </div>
</section>

<style>
  .closing {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 110svh;
    overflow: hidden;
    background: #0d1414;
  }
  .closing__media {
    position: absolute;
    inset: 0;
  }
  .closing__shade {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 60% at 50% 50%, rgba(4, 30, 31, 0.55) 0%, rgba(4, 30, 31, 0.85) 100%),
      linear-gradient(0deg, rgba(4, 57, 59, 0.9) 0%, transparent 30%);
  }
  .closing__inner {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 3rem;
    text-align: center;
    padding-block: var(--section-y);
  }
  .closing__inner .display em {
    color: #efe3cf;
  }
  .closing__cta {
    display: grid;
    justify-items: center;
    gap: 1.5rem;
  }
  .closing__copy {
    max-width: 38rem;
    margin: 0;
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    line-height: 1.6;
    color: var(--on-dark-soft);
  }
  .closing__cta p {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--on-dark-soft);
  }
</style>
