---
import { IMAGES, photo, srcset } from '../data/images';
---

<section class="hero on-dark" aria-labelledby="hero-title">
  <div class="hero__media media" aria-hidden="true">
    <img
      data-parallax="0.22"
      src={photo(IMAGES.thaliDark, 1800)}
      srcset={srcset(IMAGES.thaliDark)}
      sizes="100vw"
      alt=""
      fetchpriority="high"
    />
  </div>
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="container hero__inner">
    <p class="eyebrow" data-reveal="fade" data-immediate>Vegetarian Indian Dining · Rotterdam</p>

    <h1 id="hero-title" class="display hero__title" data-reveal="lines" data-immediate>
      <span class="line"><span>India on the plate.</span></span>
      <span class="line"><span><em>Rotterdam around</em></span></span>
      <span class="line"><span><em>the table.</em></span></span>
    </h1>

    <div class="hero__foot">
      <p class="lede" data-reveal="fade" data-immediate data-delay="0.35">
        Bold vegetarian Indian flavours, familiar favourites and something worth staying in for.
      </p>
      <div class="hero__ctas" data-reveal="fade" data-immediate data-delay="0.5">
        <a class="btn btn--light" href="/reserve#table">Reserve a Table <span class="arrow">→</span></a>
        <a class="link-arrow" href="#find">Find Us <span class="arrow">→</span></a>
      </div>
    </div>
  </div>

  <div class="container hero__meta" data-reveal="fade" data-immediate data-delay="0.7">
    <span class="hero__pin"><i aria-hidden="true"></i> Zin &amp; Gin · Inside Teleport Hotel, Rotterdam</span>
    <span class="hero__scroll" aria-hidden="true">Scroll <b></b></span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto;
    min-height: 100svh;
    overflow: hidden;
    background: #0d1414;
  }
  .hero__media {
    position: absolute;
    inset: 0;
    background: #0d1414;
  }
  .hero__media img {
    object-position: 60% 50%;
  }
  @media (min-width: 1024px) {
    .hero__media {
      left: 34%;
    }
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, #0d1414 0%, #0d1414 33%, rgba(13, 20, 20, 0.55) 48%, rgba(6, 22, 23, 0) 70%),
      linear-gradient(0deg, rgba(4, 57, 59, 0.75) 0%, transparent 38%),
      linear-gradient(180deg, rgba(6, 22, 23, 0.55) 0%, transparent 22%);
  }
  .hero__inner {
    position: relative;
    display: grid;
    align-content: end;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding-top: calc(var(--nav-h) + 4rem);
    padding-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  .hero__inner .eyebrow {
    color: var(--ivory);
  }
  .hero__title {
    font-size: clamp(3.2rem, 7.2vw, 8.2rem);
    text-shadow: 0 2px 40px rgba(0, 0, 0, 0.35);
  }
  .hero__title em {
    color: #efe3cf;
  }
  .hero__foot {
    display: grid;
    gap: 2rem;
    justify-items: start;
  }
  .hero__foot .lede {
    max-width: 26rem;
  }
  .hero__ctas {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .hero__meta {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-block: 1.4rem;
    border-top: 1px solid var(--on-dark-faint);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--on-dark-soft);
  }
  .hero__pin {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
  }
  .hero__pin i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--terra);
    box-shadow: 0 0 0 0 rgba(199, 101, 60, 0.6);
    animation: pin-pulse 2.6s infinite;
  }
  @keyframes pin-pulse {
    70% {
      box-shadow: 0 0 0 12px rgba(199, 101, 60, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(199, 101, 60, 0);
    }
  }
  .hero__scroll {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
  }
  .hero__scroll b {
    position: relative;
    width: 56px;
    height: 1px;
    overflow: hidden;
    background: var(--on-dark-faint);
  }
  .hero__scroll b::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--ivory);
    animation: scroll-line 2.4s var(--ease-in-out) infinite;
  }
  @keyframes scroll-line {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(100%);
    }
  }
  @media (max-width: 767px) {
    .hero__media img {
      object-position: 62% 50%;
    }
    .hero__shade {
      background:
        linear-gradient(0deg, rgba(6, 22, 23, 0.95) 0%, rgba(6, 22, 23, 0.7) 45%, rgba(6, 22, 23, 0.2) 100%);
    }
    .hero__ctas .btn {
      width: 100%;
    }
    .hero__scroll {
      display: none;
    }
    .hero__meta {
      font-size: 0.62rem;
      letter-spacing: 0.14em;
      padding-bottom: 6.5rem;
    }
  }
</style>
