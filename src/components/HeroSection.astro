---
import { IMAGES } from '../data/images';
import BrandDoodles from './BrandDoodles.astro';
---

<section class="hero on-dark" data-surface="dark" aria-labelledby="hero-title">
  <BrandDoodles />
  <div class="hero__media media" aria-hidden="true">
    <img
      class="hero__poster-fallback hero__photo"
      src={IMAGES.heroFeast}
      alt=""
      fetchpriority="high"
      decoding="async"
      width="1024"
      height="697"
    />
  </div>
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="container container--sym hero__inner">
    <p class="eyebrow hero__eyebrow" data-reveal="fade" data-immediate>Inside Teleport Hotel, Rotterdam</p>

    <h1 id="hero-title" class="display hero__title" data-reveal="lines" data-immediate>
      <span class="line"><span>Authentic vegetarian <em>restaurant</em> &amp; bar</span></span>
    </h1>

    <div class="hero__foot">
      <p class="lede" data-reveal="fade" data-immediate data-delay="0.35">
        Bold vegetarian Indian flavours. Botanical gin. Cocktails worth staying for.
      </p>
      <div class="hero__ctas" data-reveal="fade" data-immediate data-delay="0.5">
        <a class="btn btn--light" href="/reserve">Reserve a Table <span class="arrow">→</span></a>
        <a class="link-arrow" href="#find">Find Us <span class="arrow">→</span></a>
      </div>
    </div>
  </div>

  <div class="container container--sym hero__meta" data-reveal="fade" data-immediate data-delay="0.7">
    <span class="hero__pin"><i aria-hidden="true"></i> Zin &amp; Gin · Inside Teleport Hotel</span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto;
    min-height: 100svh;
    overflow: hidden;
    background: #0d1414;
  }
  .hero__media {
    position: absolute;
    inset: 0;
    background: #0d1414;
  }
  .hero__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 42% 50%;
    transform: translateZ(0);
  }
  .hero__poster-fallback {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(
        90deg,
        rgba(4, 57, 59, 0.62) 0%,
        rgba(6, 22, 23, 0.34) 26%,
        rgba(6, 22, 23, 0.1) 42%,
        transparent 58%
      ),
      linear-gradient(0deg, rgba(4, 57, 59, 0.4) 0%, transparent 34%),
      linear-gradient(180deg, rgba(6, 22, 23, 0.38) 0%, transparent 18%);
  }
  .hero__inner {
    position: relative;
    z-index: 2;
    display: grid;
    align-content: end;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding-top: calc(var(--nav-h) + 4rem);
    padding-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  .hero__eyebrow {
    font-size: clamp(0.72rem, 1.6vw, 0.92rem);
    letter-spacing: 0.22em;
    color: var(--ivory);
  }
  .hero__inner .eyebrow {
    color: var(--ivory);
  }
  .hero__title {
    font-size: clamp(2.9rem, 6.8vw, 6.55rem);
    font-weight: 700;
    line-height: 1.05;
    max-width: 14ch;
    text-shadow: 0 2px 40px rgba(0, 0, 0, 0.35);
  }
  .hero__title em {
    font-style: italic;
    font-weight: 700;
    color: #efe3cf;
  }
  .hero__foot {
    display: grid;
    gap: 2rem;
    justify-items: start;
  }
  .hero__foot .lede {
    max-width: 26rem;
  }
  .hero__ctas {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .hero__meta {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 1rem;
    max-width: 100%;
    overflow: hidden;
    padding-block: 1.4rem;
    border-top: 1px solid var(--on-dark-faint);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--on-dark-soft);
  }
  .hero__pin {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
  }
  .hero__pin i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--terra);
    box-shadow: 0 0 0 0 rgba(199, 101, 60, 0.6);
    animation: pin-pulse 2.6s infinite;
  }
  @keyframes pin-pulse {
    70% {
      box-shadow: 0 0 0 12px rgba(199, 101, 60, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(199, 101, 60, 0);
    }
  }
  .hero__scroll {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
  }
  .hero__scroll b {
    position: relative;
    width: 56px;
    height: 1px;
    overflow: hidden;
    background: var(--on-dark-faint);
  }
  .hero__scroll b::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--ivory);
    animation: scroll-line 2.4s var(--ease-in-out) infinite;
  }
  @keyframes scroll-line {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(100%);
    }
  }
  @media (max-width: 767px) {
    .hero__shade {
      background:
        linear-gradient(0deg, rgba(4, 57, 59, 0.95) 0%, rgba(4, 57, 59, 0.72) 48%, rgba(6, 22, 23, 0.25) 100%);
    }
    .hero__title {
      max-width: 12ch;
      font-size: clamp(2.5rem, 11vw, 3.35rem);
      line-height: 1.08;
    }
    .hero__ctas .btn {
      width: 100%;
    }
    .hero__scroll {
      display: none;
    }
    .hero__meta {
      font-size: 0.62rem;
      letter-spacing: 0.14em;
      padding-bottom: 6.5rem;
    }
  }
</style>
