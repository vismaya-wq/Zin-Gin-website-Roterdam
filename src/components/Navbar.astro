---
import { NAV } from '../data/site';

interface Props {
  tone: 'light' | 'dark';
  current: 'home' | 'menu' | 'reserve';
}

const { tone, current } = Astro.props;
const isCurrent = (href: string) => (href === '/' && current === 'home') || (href === '/menu' && current === 'menu');
---

<header class:list={['nav', `nav--${tone}`]} data-nav>
  <div class="nav__inner">
    <a href="/" class="nav__brand" aria-label="Zin & Gin — home">
      <img src="/zin-gin-badge.png" alt="" width="56" height="56" />
      <span class="nav__word">
        <span>Zin &amp; Gin</span>
        <small>Rotterdam</small>
      </span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      {
        NAV.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            <span data-text={item.label}>{item.label}</span>
          </a>
        ))
      }
    </nav>

    <div class="nav__actions">
      <a href="/reserve#table" class="nav__reserve" aria-current={current === 'reserve' ? 'page' : undefined}>
        Reserve <span class="arrow" aria-hidden="true">→</span>
      </a>
      <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-nav-toggle>
        <span class="sr-only">Open menu</span>
        <span class="nav__bars" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  <div class="nav__sheet" id="mobile-menu" data-nav-sheet>
    <nav aria-label="Mobile">
      {
        NAV.map((item, index) => (
          <a href={item.href} style={`--i:${index}`}>
            <small>0{index + 1}</small>
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="nav__sheet-foot">
      <p>Schiekade 730 · Inside Teleport Hotel</p>
      <a class="btn btn--light" href="/reserve#table">Reserve a Table <span class="arrow">→</span></a>
    </div>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const toggle = nav.querySelector<HTMLButtonElement>('[data-nav-toggle]')!;
  const setOpen = (open: boolean) => {
    nav.classList.toggle('is-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.querySelector('.sr-only')!.textContent = open ? 'Close menu' : 'Open menu';
    window.zgLockScroll?.(open);
    document.body.style.overflow = open ? 'hidden' : '';
  };
  toggle.addEventListener('click', () => setOpen(!nav.classList.contains('is-open')));
  nav.querySelectorAll('[data-nav-sheet] a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && nav.classList.contains('is-open')) setOpen(false);
  });
</script>

<style>
  .nav {
    --fg: var(--ivory);
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 60;
    color: var(--fg);
    transition:
      transform 0.7s var(--ease-out),
      color 0.5s var(--ease-out);
  }
  .nav--dark {
    --fg: var(--petrol);
  }
  .nav::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(251, 248, 241, 0.86);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    border-bottom: 1px solid rgba(7, 93, 97, 0.1);
    opacity: 0;
    transition: opacity 0.5s var(--ease-out);
  }
  .nav:global(.is-scrolled) {
    --fg: var(--petrol);
  }
  .nav:global(.is-scrolled)::before {
    opacity: 1;
  }
  .nav:global(.is-hidden) {
    transform: translateY(-100%);
  }

  .nav__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: var(--nav-h);
    max-width: var(--max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    justify-self: start;
  }
  .nav__brand img {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.18);
    transition: transform 0.8s var(--ease-out);
  }
  .nav__brand:hover img {
    transform: rotate(-12deg);
  }
  .nav__word {
    display: flex;
    flex-direction: column;
    font-family: var(--serif);
    font-size: 1.45rem;
    line-height: 1;
  }
  .nav__word small {
    margin-top: 0.3rem;
    font-family: var(--sans);
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .nav__links {
    display: flex;
    gap: clamp(1.25rem, 2.4vw, 2.6rem);
  }
  .nav__links a {
    position: relative;
    display: block;
    overflow: hidden;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding-block: 0.3rem;
  }
  .nav__links a span {
    display: block;
    transition: transform 0.6s var(--ease-out);
  }
  .nav__links a span::after {
    content: attr(data-text);
    position: absolute;
    left: 0;
    top: 100%;
    font-style: normal;
  }
  .nav__links a:hover span {
    transform: translateY(-100%);
  }
  .nav__links a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -2px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--terra);
    transform: translateX(-50%);
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    justify-self: end;
  }
  .nav__reserve {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    height: 46px;
    padding: 0 1.4rem;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px currentColor;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition:
      background 0.4s var(--ease-out),
      color 0.4s var(--ease-out),
      box-shadow 0.4s var(--ease-out);
  }
  .nav__reserve:hover {
    background: var(--fg);
    color: var(--nav-reserve-hover, var(--petrol));
  }
  .nav--dark .nav__reserve:hover,
  .nav:global(.is-scrolled) .nav__reserve:hover {
    color: var(--ivory);
  }
  .nav__reserve .arrow {
    transition: transform 0.5s var(--ease-out);
  }
  .nav__reserve:hover .arrow {
    transform: translateX(4px);
  }

  .nav__toggle {
    display: none;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px currentColor;
  }
  .nav__bars {
    position: relative;
    display: block;
    width: 18px;
    height: 8px;
    margin: auto;
  }
  .nav__bars i {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.5s var(--ease-out), top 0.5s var(--ease-out);
  }
  .nav__bars i:first-child {
    top: 0;
  }
  .nav__bars i:last-child {
    top: 6.5px;
  }
  .nav:global(.is-open) .nav__bars i:first-child {
    top: 3.25px;
    transform: rotate(45deg);
  }
  .nav:global(.is-open) .nav__bars i:last-child {
    top: 3.25px;
    transform: rotate(-45deg);
  }

  .nav__sheet {
    position: fixed;
    inset: 0;
    z-index: -1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: calc(var(--nav-h) + 2rem) var(--gutter) calc(2rem + env(safe-area-inset-bottom));
    background: var(--petrol);
    color: var(--ivory);
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.9s var(--ease-in-out);
    visibility: hidden;
  }
  .nav:global(.is-open) {
    --fg: var(--ivory);
  }
  .nav:global(.is-open)::before {
    opacity: 0;
  }
  .nav:global(.is-open) .nav__sheet {
    clip-path: inset(0 0 0 0);
    visibility: visible;
  }
  .nav__sheet nav {
    display: flex;
    flex-direction: column;
  }
  .nav__sheet nav a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--on-dark-faint);
    font-family: var(--serif);
    font-size: clamp(2.4rem, 11vw, 3.4rem);
    line-height: 1;
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.6s var(--ease-out),
      transform 0.8s var(--ease-out);
  }
  .nav:global(.is-open) .nav__sheet nav a {
    opacity: 1;
    transform: none;
    transition-delay: calc(0.25s + var(--i) * 0.06s);
  }
  .nav__sheet nav small {
    font-family: var(--sans);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    color: var(--terra);
  }
  .nav__sheet-foot {
    display: grid;
    gap: 1.25rem;
  }
  .nav__sheet-foot p {
    margin: 0;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--on-dark-soft);
  }

  @media (max-width: 1023px) {
    .nav__inner {
      grid-template-columns: 1fr auto;
    }
    .nav__links {
      display: none;
    }
    .nav__toggle {
      display: grid;
    }
  }
  @media (max-width: 767px) {
    .nav__brand img {
      width: 44px;
      height: 44px;
    }
    .nav__word {
      font-size: 1.25rem;
    }
    .nav__reserve {
      height: 42px;
      padding: 0 1.1rem;
    }
    .nav__toggle {
      width: 42px;
      height: 42px;
    }
  }
  @media (max-width: 380px) {
    .nav__word small {
      display: none;
    }
  }
</style>
