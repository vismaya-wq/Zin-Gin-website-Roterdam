---
import { photo, srcset } from '../data/images';

interface Props {
  variant: 'pair' | 'wide';
  images: { id: string; alt: string }[];
  caption?: string;
}

const { variant, images, caption } = Astro.props;
---

<aside class:list={['interlude', `interlude--${variant}`]} aria-label={caption ?? 'From the kitchen'}>
  <div class="container interlude__grid">
    {
      images.map((image, index) => (
        <figure class="interlude__fig" data-drift={variant === 'pair' && index === 1 ? '70' : undefined}>
          <div class="media" data-reveal="image" data-delay={String(index * 0.15)}>
            <img
              data-parallax={variant === 'wide' ? '0.2' : undefined}
              src={photo(image.id, variant === 'wide' ? 2000 : 1200)}
              srcset={srcset(image.id, variant === 'wide' ? [900, 1600, 2400] : [600, 1000, 1400])}
              sizes={variant === 'wide' ? '100vw' : '(min-width: 1024px) 45vw, 90vw'}
              alt={image.alt}
              loading="lazy"
            />
          </div>
        </figure>
      ))
    }
    {caption && <p class="interlude__caption" data-reveal="fade">{caption}</p>}
  </div>
</aside>

<style>
  .interlude {
    padding-block: clamp(2rem, 5vw, 5rem) clamp(5rem, 9vw, 8rem);
  }
  .interlude__fig {
    margin: 0;
  }
  .interlude--pair .interlude__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1.5rem;
    align-items: start;
  }
  .interlude--pair .interlude__fig:first-child {
    grid-column: 1 / span 7;
  }
  .interlude--pair .interlude__fig:first-child .media {
    aspect-ratio: 16 / 11;
  }
  .interlude--pair .interlude__fig:nth-child(2) {
    grid-column: 9 / span 4;
    margin-top: 8rem;
  }
  .interlude--pair .interlude__fig:nth-child(2) .media {
    aspect-ratio: 3 / 4;
    border-radius: 999px 999px 0 0;
  }
  .interlude--pair .interlude__caption {
    grid-column: 9 / span 4;
  }

  .interlude--wide .interlude__grid {
    max-width: none;
    padding-inline: 0;
  }
  .interlude--wide .media {
    height: min(88vh, 820px);
  }
  .interlude--wide .interlude__caption {
    padding-inline: var(--gutter);
    text-align: right;
  }
  .interlude__caption {
    margin: 1.25rem 0 0;
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.35rem;
    color: var(--ink-soft);
  }
  @media (max-width: 767px) {
    .interlude--pair .interlude__fig:first-child {
      grid-column: 1 / -1;
    }
    .interlude--pair .interlude__fig:nth-child(2) {
      grid-column: 5 / -1;
      margin-top: -4rem;
    }
    .interlude--pair .interlude__caption {
      grid-column: 1 / -1;
    }
    .interlude--wide .media {
      height: 60vh;
    }
  }
</style>
