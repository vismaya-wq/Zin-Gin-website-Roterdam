---
import Layout from '../layouts/Layout.astro';
import ReservationFlow from '../components/ReservationFlow.tsx';
---

<Layout
  title="Reserve a table"
  page="reserve"
  navTone="dark"
  description="Reserve a table at Zin & Gin, inside Teleport Hotel, Rotterdam. Two short steps. Confirmed by the restaurant team."
>
  <section class="rhero" data-surface="light" aria-labelledby="reserve-title">
    <div class="container">
      <header class="rhero__head">
        <p class="eyebrow eyebrow--terra">Guest reservation</p>
        <h1 id="reserve-title" class="h1">Reserve a table</h1>
        <p class="lede">One simple request — our team confirms availability shortly.</p>
      </header>
      <ReservationFlow client:load />
    </div>
  </section>
</Layout>

<style>
  .rhero {
    padding-top: calc(var(--nav-h) + clamp(2.5rem, 6vw, 4.5rem));
    padding-bottom: clamp(4rem, 8vw, 7rem);
    background: var(--cream);
    color: var(--petrol);
  }
  .rhero__head {
    display: grid;
    gap: 0.8rem;
    max-width: 40rem;
    margin-bottom: 2rem;
  }
</style>
